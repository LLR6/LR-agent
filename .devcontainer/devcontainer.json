{
  "name": "LR-Agent Research Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -e '.[dev]'",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "LR-Agent Web UI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteEnv": {
    "LR_AGENT_WORKSPACE": "${containerWorkspaceFolder}/examples/chronoforge-demo"
  }
}
