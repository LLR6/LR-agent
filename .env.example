# OpenAI-compatible model endpoint
LR_AGENT_BASE_URL=https://api.openai.com/v1
LR_AGENT_API_KEY=
LR_AGENT_MODEL=gpt-5.6

# Agent
LR_AGENT_MAX_STEPS=12
LR_AGENT_MAX_CONCURRENT_TASKS=2
LR_AGENT_ENABLE_PLANNING=true
LR_AGENT_ENABLE_REVIEW=true
LR_AGENT_MAX_REVIEW_RETRIES=1
LR_AGENT_REQUEST_TIMEOUT_S=120
LR_AGENT_MODEL_RETRIES=2
LR_AGENT_COMMAND_TIMEOUT_S=60

# Local data
LR_AGENT_WORKSPACE=./workspace
LR_AGENT_DATABASE=./data/lr_agent.db
LR_AGENT_KNOWLEDGE_DATABASE=./data/knowledge.db
LR_AGENT_KNOWLEDGE_MAX_FILES=3000
LR_AGENT_KNOWLEDGE_MAX_FILE_BYTES=1000000
LR_AGENT_AUTO_CONTEXT=true
LR_AGENT_AUTO_CONTEXT_RESULTS=6

# Commands the agent may execute. Comma-separated executable names.
LR_AGENT_ALLOWED_COMMANDS=python,python3,pytest,git,gh,pip,uv,pwd,ls,dir,find,where,node,npm,npx,pnpm,yarn,java,javac,mvn,gradle,gradlew,gradlew.bat,cargo,go,cmake,ctest

# Safety defaults
LR_AGENT_ALLOW_DESTRUCTIVE=false
LR_AGENT_ALLOW_PRIVATE_NETWORK=false

# Optional interactive approval gate:
# off    = no interactive approval
# writes = ask before local/GitHub write tools
# all    = writes + run_command
LR_AGENT_APPROVAL_MODE=off
LR_AGENT_APPROVAL_TIMEOUT_S=600

# Web/API authentication. Strongly recommended for any non-loopback deployment.
LR_AGENT_WEB_TOKEN=
LR_AGENT_ALLOW_REMOTE_WITHOUT_TOKEN=false

# GitHub native tools (reads work for public repositories without a token)
LR_AGENT_GITHUB_TOKEN=
LR_AGENT_GITHUB_API_BASE=https://api.github.com
LR_AGENT_ALLOW_GITHUB_WRITE=false
