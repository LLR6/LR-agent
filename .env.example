# OpenAI-compatible model endpoint
LR_AGENT_BASE_URL=https://api.openai.com/v1
LR_AGENT_API_KEY=
LR_AGENT_MODEL=gpt-5.6

# Agent
LR_AGENT_MAX_STEPS=12
LR_AGENT_REQUEST_TIMEOUT_S=120
LR_AGENT_COMMAND_TIMEOUT_S=60

# Local data
LR_AGENT_WORKSPACE=./workspace
LR_AGENT_DATABASE=./data/lr_agent.db

# Commands the agent may execute. Comma-separated executable names.
LR_AGENT_ALLOWED_COMMANDS=python,python3,pytest,git,gh,pip,uv,pwd,ls,dir,find,where

# Safety defaults
LR_AGENT_ALLOW_DESTRUCTIVE=false
LR_AGENT_ALLOW_PRIVATE_NETWORK=false
