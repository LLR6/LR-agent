{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LLR6/LR-agent/schemas/artifact-bundle.schema.json",
  "title": "LR-Agent research artifact bundle",
  "type": "object",
  "required": ["schema", "manifest_sha256", "artifacts", "bundle_sha256"],
  "properties": {
    "schema": {"const": "lr-agent-artifact-bundle/v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
